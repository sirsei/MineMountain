-- A. Auto Dig & Auto Aim Ke Model Aktif
local digMultiplier = 2
RunService.Heartbeat:Connect(function()
    if isDiggingActive and DigEvent then
        local character = player.Character
        local currentTool = character and character:FindFirstChildOfClass("Tool")
        if not currentTool then return end

        local dynamicItemName = currentTool.Name
        local targetPos = GetTargetModelPosition(currentTargetModel) or player:GetMouse().Hit.Position

        if targetPos then
            for i = 1, digMultiplier do
                DigEvent:FireServer(dynamicItemName, targetPos)
            end
        end
    end
end)

-- B. Auto Collect Prompt & Cache
local promptCache = {}
for _, obj in ipairs(workspace:GetDescendants()) do
    if obj:IsA("ProximityPrompt") then table.insert(promptCache, obj) end
end
workspace.DescendantAdded:Connect(function(obj)
    if obj:IsA("ProximityPrompt") then table.insert(promptCache, obj) end
end)
workspace.DescendantRemoving:Connect(function(obj)
    if obj:IsA("ProximityPrompt") then
        local idx = table.find(promptCache, obj)
        if idx then table.remove(promptCache, idx) end
    end
end)

local function TriggerPrompt(prompt)
    if not isCollectActive or not prompt then return end
    pcall(function()
        prompt.HoldDuration = 0
        if fireproximityprompt then
            fireproximityprompt(prompt)
        else
            prompt:InputHoldBegin()
            task.wait()
            prompt:InputHoldEnd()
        end
    end)
end

local function HasCollectablesInRange(radius)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    for _, prompt in ipairs(promptCache) do
        if prompt and prompt.Enabled and prompt.Parent then
            local parent = prompt.Parent
            local pos = parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and parent:GetPivot().Position)
            if pos then
                local dist = (hrp.Position - pos).Magnitude
                if dist <= (radius or COLLECT_RADIUS) then
                    return true
                end
            end
        end
    end
    return false
end

ProximityPromptService.PromptShown:Connect(function(prompt) 
    if isCollectActive then
        pcall(function() prompt.HoldDuration = 0 end) 
    end
end)

ProximityPromptService.PromptButtonHoldBegan:Connect(function(prompt)
    if isCollectActive then
        TriggerPrompt(prompt)
    end
end)

RunService.Heartbeat:Connect(function()
    if not isCollectActive then return end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local shortestDist = math.huge
    local nearestPrompt = nil

    for _, prompt in ipairs(promptCache) do
        if prompt.Enabled and prompt.Parent then
            local parent = prompt.Parent
            local pos = parent:IsA("BasePart") and parent.Position or (parent:IsA("Model") and parent:GetPivot().Position)
            if pos then
                local dist = (hrp.Position - pos).Magnitude
                if dist <= prompt.MaxActivationDistance and dist < shortestDist then
                    shortestDist = dist
                    nearestPrompt = prompt
                end
            end
        end
    end

    if nearestPrompt then
        TriggerPrompt(nearestPrompt)
    end
end)

---------------------------------------------------------
-- 5. TWEEN ENGINE & LOCK SYSTEM
---------------------------------------------------------

local function getBottomCFrame(target)
    if target:IsA("Model") then
        local cframe, size = target:GetBoundingBox()
        return cframe * CFrame.new(0, 3, 0)
    else
        return target.CFrame * CFrame.new(0, 3, 0)
    end
end

local function applyPositionLock(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    local bv = hrp:FindFirstChild("TempLockVelocity") or Instance.new("BodyVelocity")
    bv.Name = "TempLockVelocity"
    bv.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bv.Velocity = Vector3.zero
    bv.Parent = hrp

    return bv
end

local function removePositionLock(character)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp then
        local bv = hrp:FindFirstChild("TempLockVelocity")
        if bv then bv:Destroy() end
    end
end

local activeTween = nil
local function tweenToTarget(character, targetCFrame, studsPerSecond)
    local hrp = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return false end

    local distance = (hrp.Position - targetCFrame.Position).Magnitude
    local duration = math.max(distance / (studsPerSecond or TWEEN_SPEED), 0.1)

    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") then
            part.CanCollide = false
        end
    end

    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    
    hrp.AssemblyLinearVelocity = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    local tweenInfo = TweenInfo.new(
        duration,
        Enum.EasingStyle.Linear,
        Enum.EasingDirection.InOut
    )

    activeTween = TweenService:Create(hrp, tweenInfo, {CFrame = targetCFrame})
    activeTween:Play()

    local completed = false
    local conn
    conn = activeTween.Completed:Connect(function()
        completed = true
        if conn then conn:Disconnect() end
    end)

    while not completed and isSequenceRunning do
        task.wait(0.05)
    end

    for _, part in ipairs(character:GetChildren()) do
        if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
            part.CanCollide = true
        end
    end
    
    humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
    hrp.AssemblyLinearVelocity = Vector3.zero

    if isSequenceRunning then
        applyPositionLock(character)
        return true
    end
    return false
end

local function getToolFromBackpackOrChar(toolName, character)
    local backpack = player:FindFirstChildOfClass("Backpack")
    local inBackpack = backpack and backpack:FindFirstChild(toolName)
    if inBackpack then return inBackpack end
    return character:FindFirstChild(toolName)
end

---------------------------------------------------------
-- 6. UTAMA: LOOPING MULTI-TARGET SEQUENCE
---------------------------------------------------------

startButton.MouseButton1Click:Connect(function()
    if isSequenceRunning then return end

    task.spawn(function()
        isSequenceRunning = true

        while isSequenceRunning do
            currentTargetModel = GetNextTarget()

            if not currentTargetModel or not currentTargetModel.Parent then
                statusLabel.Text = "> ALL TARGETS CLEARED! WAITING..."
                statusLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
                task.wait(2)
                continue
            end

            local character = player.Character or player.CharacterAdded:Wait()
            local hrp = character:FindFirstChild("HumanoidRootPart")
            local humanoid = character:FindFirstChildOfClass("Humanoid")

            if not hrp or not humanoid then break end

            local bombTool = getToolFromBackpackOrChar("Classic Bomb", character)
            if not bombTool then
                statusLabel.Text = "> ERR: NO CLASSIC BOMB!"
                statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
                isSequenceRunning = false
                break
            end

            isDiggingActive = false
            isCollectActive = false

            statusLabel.Text = "> GLIDING TO: " .. currentTargetModel.Name
            statusLabel.TextColor3 = Color3.fromRGB(255, 255, 0)

            local targetCFrame = getBottomCFrame(currentTargetModel)
            local success = tweenToTarget(character, targetCFrame, TWEEN_SPEED)
            
            if not success or not isSequenceRunning then break end

            for i = 2, 1, -1 do
                if not isSequenceRunning then break end
                statusLabel.Text = string.format("> HOLDING POSITION (%d S)...", i)
                statusLabel.TextColor3 = Color3.fromRGB(0, 191, 255)
                task.wait(1)
            end
            if not isSequenceRunning then break end

            statusLabel.Text = "> DROPPING BOMB..."
            statusLabel.TextColor3 = Color3.fromRGB(255, 165, 0)

            if bombTool.Parent ~= character then
                humanoid:EquipTool(bombTool)
                task.wait(0.3)
            end
            
            bombTool:Activate()
            task.wait(0.5)

            for i = math.ceil(BOMB_EXPLODE_DELAY), 1, -1 do
                if not isSequenceRunning then break end
                statusLabel.Text = string.format("> WAITING EXPLOSION (%d S)...", i)
                statusLabel.TextColor3 = Color3.fromRGB(255, 69, 0)
                task.wait(1)
            end
            if not isSequenceRunning then break end

            removePositionLock(character)

            statusLabel.Text = "> EQUIPPING PICKAXE..."
            statusLabel.TextColor3 = Color3.fromRGB(255, 255, 255)

            local pickaxeTool = nil
            local backpack = player:FindFirstChildOfClass("Backpack")
            local playerData = player:FindFirstChild("PlayerData")
            local invPickaxes = playerData and playerData:FindFirstChild("Inventory") and playerData.Inventory:FindFirstChild("Pickaxes")

            local targetPickaxeName = nil
            if invPickaxes then
                local equippedValue = invPickaxes:FindFirstChild("Equipped") or invPickaxes:FindFirstChildOfClass("StringValue")
                if equippedValue and equippedValue:IsA("ValueBase") then
                    targetPickaxeName = tostring(equippedValue.Value)
                else
                    local firstPick = invPickaxes:GetChildren()[1]
                    if firstPick then targetPickaxeName = firstPick.Name end
                end
            end

            if backpack then
                if targetPickaxeName then
                    pickaxeTool = backpack:FindFirstChild(targetPickaxeName) or character:FindFirstChild(targetPickaxeName)
                end
                
                if not pickaxeTool then
                    for _, item in ipairs(backpack:GetChildren()) do
                        if item:IsA("Tool") and string.find(item.Name:lower(), "pickaxe") then
                            pickaxeTool = item
                            break
                        end
                    end
                end
            end

            if pickaxeTool and pickaxeTool:IsA("Tool") then
                humanoid:EquipTool(pickaxeTool)
                task.wait(0.3)
            else
                local invTool = invPickaxes and invPickaxes:FindFirstChildOfClass("Tool")
                if invTool then
                    humanoid:EquipTool(invTool)
                    task.wait(0.3)
                end
            end

            isDiggingActive = true
            statusLabel.Text = "> MINING: " .. currentTargetModel.Name
            statusLabel.TextColor3 = Color3.fromRGB(255, 255, 0)

            while currentTargetModel and currentTargetModel.Parent and isSequenceRunning do
                task.wait(0.2)
            end

            isDiggingActive = false
            if isSequenceRunning then
                isCollectActive = true
                statusLabel.Text = "> DESTROYED! COLLECTING ALL DROPS..."
                statusLabel.TextColor3 = Color3.fromRGB(0, 255, 0)
                
                task.wait(0.5)

                local collectStartTime = tick()
                local noItemsTimer = 0

                while isSequenceRunning do
                    if HasCollectablesInRange(COLLECT_RADIUS) then
                        noItemsTimer = 0
                    else
                        noItemsTimer = noItemsTimer + 0.2
                        if noItemsTimer >= 1.2 then
                            break
                        end
                    end

                    if (tick() - collectStartTime) >= MAX_COLLECT_TIMEOUT then
                        break
                    end

                    task.wait(0.2)
                end

                isCollectActive = false
            end
        end

        if player.Character then removePositionLock(player.Character) end
    end)
end)

stopButton.MouseButton1Click:Connect(function()
    isSequenceRunning = false
    isDiggingActive = false
    isCollectActive = false
    currentTargetModel = nil

    if activeTween then
        activeTween:Cancel()
    end

    if player.Character then
        removePositionLock(player.Character)
        local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
        if humanoid then
            humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
        end
    end

    statusLabel.Text = "> STOPPED ALL SYSTEMS!"
    statusLabel.TextColor3 = Color3.fromRGB(255, 0, 0)
end)
