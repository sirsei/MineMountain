---------------------------------------------------------
-- DYNAMIC NAME SCANNED FROM WORKSPACE
---------------------------------------------------------
local function GetBoulderNames()
    local names = {}
    local hash = {}

    if bouldersFolder then
        for _, child in ipairs(bouldersFolder:GetChildren()) do
            if child and not hash[child.Name] then
                hash[child.Name] = true
                table.insert(names, child.Name)
            end
        end
    end
    table.sort(names)
    return names
end

local scannedNames = GetBoulderNames()

-- Pilihan Target Mining ("All" + Hasil Scan Workspace)
local modelOptions = {"All"}
for _, name in ipairs(scannedNames) do
    table.insert(modelOptions, name)
end

-- Pilihan ESP ("OFF", "All" + Hasil Scan Workspace)
local espOptions = {"OFF", "All"}
for _, name in ipairs(scannedNames) do
    table.insert(espOptions, name)
end

---------------------------------------------------------
-- 1. UTILITY: DYNAMIC TARGET FINDER
---------------------------------------------------------
local function GetNextTarget()
    if not bouldersFolder then return nil end

    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    local closestTarget = nil
    local shortestDistance = math.huge

    for _, child in ipairs(bouldersFolder:GetChildren()) do
        if child and child.Parent then
            -- Filter berdasarkan Dropdown Auto Mining
            if selectedMiningTarget ~= "All" and child.Name ~= selectedMiningTarget then
                continue
            end

            local pos = nil
            if child:IsA("Model") then
                pos = child.PrimaryPart and child.PrimaryPart.Position or child:GetPivot().Position
            elseif child:IsA("BasePart") then
                pos = child.Position
            end

            if pos then
                if hrp then
                    local dist = (hrp.Position - pos).Magnitude
                    if dist < shortestDistance then
                        shortestDistance = dist
                        closestTarget = child
                    end
                else
                    return child
                end
            end
        end
    end

    return closestTarget
end

local function GetTargetModelPosition(target)
    local obj = target or currentTargetModel
    if obj and obj.Parent then
        return obj:IsA("Model") and (obj.PrimaryPart and obj.PrimaryPart.Position or obj:GetPivot().Position) or obj.Position
    end
    return nil
end

