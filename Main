---------------------------------------------------------
-- 3. HIGHLIGHT & UTILITIES ESP
---------------------------------------------------------
local voltiteHighlightCache = {}

local function applyBoulderESP(boulder)
    if not boulder:IsA("Model") and not boulder:IsA("BasePart") then return end

    local highlight = voltiteHighlightCache[boulder] or boulder:FindFirstChild("BoulderESP")
    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "BoulderESP"
        highlight.FillColor = Color3.fromRGB(0, 255, 128)
        highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
        highlight.FillTransparency = 0.4
        highlight.OutlineTransparency = 0
        highlight.Adornee = boulder
        highlight.Parent = boulder
        voltiteHighlightCache[boulder] = highlight
    end

    -- Dynamic Match berdasarkan nama persis
    if selectedESPTarget == "OFF" then
        highlight.Enabled = false
    elseif selectedESPTarget == "All" then
        highlight.Enabled = true
    else
        highlight.Enabled = (boulder.Name == selectedESPTarget)
    end
end

function updateAllESP()
    if bouldersFolder then
        for _, child in ipairs(bouldersFolder:GetChildren()) do
            applyBoulderESP(child)
        end
    end
end

task.spawn(function()
    if bouldersFolder then
        updateAllESP()
        bouldersFolder.ChildAdded:Connect(applyBoulderESP)
    end
end)

---------------------------------------------------------
-- SERVER HOP FITUR
---------------------------------------------------------
local function ServerHop()
    statusLabel.Text = "> SEARCHING NEW SERVER..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 255, 0)
    
    local placeId = game.PlaceId
    local servers = {}
    local req = request or http_request or (syn and syn.request)
    
    if req then
        local url = string.format("https://games.roblox.com/v1/games/%s/servers/0?sortOrder=Asc&limit=100", tostring(placeId))
        local response = req({Url = url, Method = "GET"})
        if response and response.Body then
            local data = HttpService:JSONDecode(response.Body)
            if data and data.data then
                for _, s in ipairs(data.data) do
                    if type(s) == "table" and s.playing < s.maxPlayers and s.id ~= game.JobId then
                        table.insert(servers, s.id)
                    end
                end
            end
        end
    end

    if #servers > 0 then
        local randomServer = servers[math.random(1, #servers)]
        statusLabel.Text = "> TELEPORTING..."
        TeleportService:TeleportToPlaceInstance(placeId, randomServer, player)
    else
        statusLabel.Text = "> HOPPING TO RANDOM..."
        TeleportService:Teleport(placeId, player)
    end
end

hopButton.MouseButton1Click:Connect(ServerHop)

