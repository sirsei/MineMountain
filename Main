-- Helper Function: Custom Dropdown Windows 95
local function CreateDropdown(parent, yPos, labelText, options, defaultText, callback)
    local label = Instance.new("TextLabel")
    label.Size = UDim2.new(0, 100, 0, 20)
    label.Position = UDim2.new(0, 10, 0, yPos)
    label.BackgroundTransparency = 1
    label.Text = labelText
    label.TextColor3 = Color3.fromRGB(0, 0, 0)
    label.Font = Enum.Font.Code
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Parent = parent

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 190, 0, 22)
    btn.Position = UDim2.new(0, 120, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = "  " .. defaultText .. "  v"
    btn.TextColor3 = Color3.fromRGB(0, 0, 0)
    btn.Font = Enum.Font.Code
    btn.TextSize = 11
    btn.BorderSizePixel = 1
    btn.TextXAlignment = Enum.TextXAlignment.Left
    btn.Parent = parent

    local container = Instance.new("ScrollingFrame")
    container.Size = UDim2.new(0, 190, 0, math.min(#options * 22, 110))
    container.Position = UDim2.new(0, 120, 0, yPos + 24)
    container.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    container.BorderSizePixel = 1
    container.Visible = false
    container.ZIndex = 10
    container.CanvasSize = UDim2.new(0, 0, 0, #options * 22)
    container.ScrollBarThickness = 4
    container.Parent = parent

    local layout = Instance.new("UIListLayout")
    layout.Parent = container

    for _, opt in ipairs(options) do
        local optBtn = Instance.new("TextButton")
        optBtn.Size = UDim2.new(1, 0, 0, 22)
        optBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        optBtn.Text = "  " .. opt
        optBtn.TextColor3 = Color3.fromRGB(0, 0, 0)
        optBtn.Font = Enum.Font.Code
        optBtn.TextSize = 11
        optBtn.BorderSizePixel = 0
        optBtn.TextXAlignment = Enum.TextXAlignment.Left
        optBtn.ZIndex = 11
        optBtn.Parent = container

        optBtn.MouseButton1Click:Connect(function()
            btn.Text = "  " .. opt .. "  v"
            container.Visible = false
            callback(opt)
        end)
    end

    btn.MouseButton1Click:Connect(function()
        container.Visible = not container.Visible
    end)
end

